    def _nadgarstek(self):
        k = "p4"
        ram_L = suma([walecY(16, 27, 31), kostka(0, 44, 27, 31, -16, 16)])
        ram_P = suma([walecY(16, -29, -25), kostka(0, 44, -29, -25, -16, 16)])
        klamra = suma([ram_L, ram_P, kostka(40, 44, -29, 31, -22, 22)])
        klamra = wytnij(klamra, [walecY(1.6, -30, -24), walecY(5, 26, 32)] +
                        [walecX(1.6, 39, 45, y, z) for y in (-5, 25) for z in (-8, 8)])
        self._dodaj(k, "J4_Klamra_U_Al3", klamra, ALU)
        self._dodaj(k, "J4_Orczyk_25T", przesun(orczyk(), V(0, 20, 0), obrot(V(-1, 0, 0), V(0, 1, 0))), ALU)
        self._dodaj(k, "J4_Sworzen_M3", walecY(1.5, -29, -21), STAL)
        self._dodaj_liste(k, "J5_Serwo_DS3225", serwo(), V(81, 0, 0), obrot(V(0, 1, 0), V(1, 0, 0)))
        ob = suma([kostka(44, 84, -21, 41, -14, 14), walecX(25, 84, 100)])
        ob = wytnij(ob, [kostka(43, 82, -10.6, 30.6, -10.4, 10.4), kostka(68.2, 71.3, -17.4, 37.6, -9.8, 9.8),
                         walecX(21, 92, 101), walecX(16, 81, 93)] +
                    [walecX(1.6, 43, 50, y, z) for y in (-5, 25) for z in (-8, 8)])
        self._dodaj(k, "J5_Obudowa_obrotu", ob, DRUK)
        self._druk("nadgarstek_obudowa_obrotu_J5.stl", ob)
        self._dodaj(k, "J5_Lozysko_6806", przesun(lozysko(30, 42, 7), V(92, 0, 0), OS_X), STAL)

    def _chwytak(self):
        k = "p5"
        W = 62.0
        ob = suma([kostka(0, 5, -W, W, -34, 44),                                   # tył
                   kostka(0, 75, W - 6, W, -34, 44), kostka(0, 75, -W, -W + 6, -34, 44),   # ściany
                   kostka(0, 75, -W, W, -34, -30),                                 # dno
                   kostka(0, 26.5, -W, W, 40, 44),                                 # góra
                   kostka(26.5, 30.5, -W + 6, W - 6, -34, 44),                     # płyta serwa
                   walecX(15, -16, 0)])                                            # piasta obrotu
        otw = [walecX(13, -17, -12), walecX(3.5, -17, 6), walecX(5, -1, 6, 0, -25),
               kostka(25.5, 31.5, -10.4, 10.4, -10.6, 30.6),
               kostka(38, 62, -W - 1, W + 1, -18, 12)]
        otw += [walecX(1.6, 25.5, 31.5, y, z) for y in (-5, 5) for z in (-14.75, 34.75)]
        otw += [walecY(1.95, -W - 1, W + 1, 68, z) for z in (-20, 20)]
        otw += [walecX(1.1, -17, -2, 8 * math.cos(a), 8 * math.sin(a))
                for a in [math.radians(45 + 90 * i) for i in range(4)]]
        ob = wytnij(ob, otw)
        self._dodaj(k, "Chwytak_Obudowa", ob, DRUK)
        self._druk("chwytak_obudowa.stl", ob)
        self._dodaj_liste(k, "Chwytak_Serwo_DS3218", serwo(), V(43, 0, 0), obrot(V(0, 0, 1), V(1, 0, 0)))
        self._dodaj(k, "Chwytak_Prety_4mm", suma([walecY(2, -W, W, 68, z) for z in (-20, 20)]), STAL)
        self._dodaj(k, "J5_Orczyk_25T", przesun(orczyk(), V(-19, 0, 0), OS_X), ALU)

        # --- zębnik (obraca się) + orczyk serwa chwytaka
        z = zebnik(MODUL, ZEBY, LUZ, 50, 8)
        z = wytnij(z, [walecX(3.5, 49, 59)] + [walecX(1.2, 49, 59, 8 * math.cos(a), 8 * math.sin(a))
                                                for a in [math.radians(45 + 90 * i) for i in range(4)]])
        self._dodaj("zebnik", "Chwytak_Zebnik_m1.5_z20", z, DRUK_B)
        self._dodaj("zebnik", "Chwytak_Orczyk", przesun(orczyk(), V(43, 0, 0), OS_X), ALU)
        self._druk("chwytak_zebnik_m1.5_z20.stl", z)

        # --- szczęka (jedna część drukowana 2x; druga obrócona o 180° wokół X)
        zr = R_ZEBNIKA + 1.25 * MODUL
        baza = suma([kostka(59, 76, 0, 16, -28, 28),
                     kostka(50, 60, 0, 16, zr, 28),
                     zebatka(MODUL, LUZ, -52, 16, R_ZEBNIKA, 25, 50, 8.5)])
        baza = wytnij(baza, [walecY(2.25, -1, 17, 68, z) for z in (-20, 20)] +
                      [walecX(2.1, 69, 77, 12, z) for z in (-14, 14)])
        palec = suma([kostka(76, 82, 0, 16, -28, 28),
                      Part.Face(Part.makePolygon([V(82, 0, -24), V(146, 0, -12), V(146, 0, 12),
                                                  V(82, 0, 24), V(82, 0, -24)])).extrude(V(0, 8, 0))])
        palec = wytnij(palec, [walecX(1.7, 75, 83, 12, z) for z in (-14, 14)] +
                       [walecX(3.0, 79.5, 83, 12, z) for z in (-14, 14)])
        nakl = kostka(98, 144, -T_NAKLADKI, 0, -11, 11)
        nakl = wytnij(nakl, [kostka(x, x + 1.2, -T_NAKLADKI - 0.1, -T_NAKLADKI + 1.0, -12, 12)
                             for x in [100 + 4 * i for i in range(11)]])
        for kk, lit in (("szczA", "A"), ("szczB", "B")):
            self._dodaj(kk, "Chwytak_Szczeka_%s" % lit, baza, DRUK_B)
            self._dodaj(kk, "Chwytak_Palec_%s" % lit, palec, DRUK)
            self._dodaj(kk, "Chwytak_Nakladka_TPU_%s" % lit, nakl, TPU)
        self._druk("chwytak_szczeka_baza_x2.stl", baza, 2)
        self._druk("chwytak_palec_x2.stl", palec, 2)
        self._druk("chwytak_nakladka_TPU_x2.stl", nakl, 2)

    def _okablowanie(self):
        g = "Okablowanie"
        self._dodaj("p0", "Kabel_z_kadluba", walecZ(5, -80, 30), OPLOT, grupa=g)
        self._dodaj("p1", "Kabel_glowny_J1", kabel([(0, 0, 29), (0, 0, 70), (-15, 25, 90), (-25, 48, 100),
                                                     (-30, 68, 125), (-25, 75, H_BARK - 43.3)], 5), OPLOT, grupa=g)
        self._dodaj("p1", "Kabel_silnika_J2", kabel([(0, 0, 70), (0, -25, 85), (-25, -48, 100), (-20, -75, 130),
                                                      (-5, -110, 160), (0, -165, 165)], 4), KABEL_CZ, grupa=g)
        self._dodaj("p2", "Petla_serwisowa_bark", zwoj(50, 5, V(0, 75, 0), V(0, 1, 0)), OPLOT, grupa=g)
        self._dodaj("p2", "Kabel_ramie", kabel([(25, 75, 43.3), (70, 62, 40), (110, 10, 30), (150, -28, 12),
                                                (250, -28, 0), (L1 - 140, -28, 0), (L1 - 118, -48, 0),
                                                (L1 - 80, -55, 0), (L1 - 40, -64, 0)], 5), OPLOT, grupa=g)
        self._dodaj("p2", "Kabel_silnika_J3", kabel([(270, -28, 0), (300, -45, 15), (330, -62, 35),
                                                     (L1 - 160, -62, 48)], 3.5), KABEL_CZ, grupa=g)
        self._dodaj("p3", "Petla_serwisowa_lokiec", zwoj(40, 4.5, V(0, -64, 0), V(0, 1, 0)), OPLOT, grupa=g)
        self._dodaj("p3", "Kabel_przedramie", kabel([(40, -64, 0), (80, -45, 0), (130, -27, 0), (L2 - 120, -27, 0),
                                                     (L2 - 60, -33, 0), (L2 - 22, -36, 0)], 4), OPLOT, grupa=g)
        self._dodaj("p3", "Kabel_serwa_J4", kabel([(300, -27, 0), (L2 - 100, -28, -10), (L2 - 75, -24, -10),
                                                   (L2 - 71, -21.5, -10)], 2.5), KABEL_CZ, grupa=g)
        self._dodaj("p4", "Petla_serwisowa_nadgarstek", zwoj(22, 3.5, V(0, -36, 0), V(0, 1, 0)), OPLOT, grupa=g)
        self._dodaj("p4", "Kabel_nadgarstek", kabel([(22, -36, 0), (36, -36, -12), (50, -30, -30),
                                                     (62, -14, -46)], 3), OPLOT, grupa=g)
        self._dodaj("p4", "Zwoj_obrotu_J5", zwoj(48, 3, V(62, 0, 0), V(1, 0, 0)), OPLOT, grupa=g)
        self._dodaj("p5", "Kabel_chwytaka", kabel([(-38, 0, -48), (-24, 0, -45), (-10, 0, -36), (-3, 0, -29),
                                                   (3, 0, -26)], 2.5), KABEL_CZ, grupa=g)

    # ------------------------------------------------------------------ ruch
    def kinematyka(self, q):
        obr, bark, lok, nad, rol, roz = q
        P, R = App.Placement, App.Rotation
        p = {"p0": self.baza}
        p["p1"] = p["p0"].multiply(P(V(0, 0, 0), R(V(0, 0, 1), obr)))
        p["p2"] = p["p1"].multiply(P(V(0, 0, H_BARK), R(V(0, 1, 0), -bark)))
        p["p3"] = p["p2"].multiply(P(V(L1, 0, 0), R(V(0, 1, 0), lok)))
        p["p4"] = p["p3"].multiply(P(V(L2, 0, 0), R(V(0, 1, 0), nad)))
        p["p5"] = p["p4"].multiply(P(V(L_WR, 0, 0), R(V(1, 0, 0), rol)))
        s = roz / 2.0 + T_NAKLADKI                        # położenie wewn. ścianki wózka
        p["szczA"] = p["p5"].multiply(P(V(0, s, 0), R()))
        p["szczB"] = p["p5"].multiply(P(V(0, -s, 0), R(V(1, 0, 0), 180)))
        p["zebnik"] = p["p5"].multiply(P(V(0, 0, 0), R(V(1, 0, 0), -math.degrees(s / R_ZEBNIKA))))
        return p

    def ustaw(self, obrot_=None, bark=None, lokiec=None, nadgarstek=None, obrot_chw=None, rozwarcie=None):
        """Ustawia pozę ramienia. Pominięte argumenty zostają bez zmian."""
        nowe = [obrot_, bark, lokiec, nadgarstek, obrot_chw, rozwarcie]
        for i, v in enumerate(nowe):
            if v is None:
                continue
            lo, hi = LIMITY[i]
            if v < lo or v > hi:
                App.Console.PrintWarning("Ramie: %s=%.1f poza zakresem [%g, %g] - przycinam\n" % (NAZWY_OSI[i], v, lo, hi))
                v = min(max(v, lo), hi)
            self.stan[i] = float(v)
        p = self.kinematyka(self.stan)
        for klucz, lista in self.obiekty.items():
            for o, lpl in lista:
                o.Placement = p[klucz].multiply(lpl)
        return p

    def poza(self, nazwa):
        return self.ustaw(*POZY[nazwa])

    def punkt_chwytu(self):
        """Środek między nakładkami szczęk (współrzędne globalne)."""
        return self.kinematyka(self.stan)["p5"].multVec(V(121, 0, 0))

    def animuj(self, sekwencja=None, krok=0.012, interwal=30):
        try:
            from PySide import QtCore
        except ImportError:
            try:
                from PySide6 import QtCore
            except ImportError:
                from PySide2 import QtCore
        import FreeCADGui as Gui
        sek = sekwencja or [POZY["transport"], POZY["wyprostowane"], POZY["prezentacja"],
                            POZY["probka"], POZY["transport"]]
        st = {"t": 0.0}

        def _krok():
            n = len(sek) - 1
            i = int(st["t"]) % n
            u = st["t"] - int(st["t"])
            u = 0.5 - 0.5 * math.cos(math.pi * u)
            a, b = sek[i], sek[i + 1]
            self.ustaw(*[a[j] + (b[j] - a[j]) * u for j in range(6)])
            Gui.updateGui()
            st["t"] += krok

        self.zatrzymaj()
        self._timer = QtCore.QTimer()
        self._timer.timeout.connect(_krok)
        self._timer.start(interwal)

    def zatrzymaj(self):
        if self._timer is not None:
            self._timer.stop()
            self._timer = None

    # ------------------------------------------------------------------ STL
    def eksportuj_stl(self, katalog):
        try:
            import MeshPart
        except ImportError:
            MeshPart = None
        os.makedirs(katalog, exist_ok=True)
        rotacje = [App.Rotation(), App.Rotation(V(1, 0, 0), 90), App.Rotation(V(1, 0, 0), -90),
                   App.Rotation(V(1, 0, 0), 180), App.Rotation(V(0, 1, 0), 90), App.Rotation(V(0, 1, 0), -90)]
        zapisane = []
        for plik, ksz, ilosc in self.do_druku:
            # orientacja do druku: największa płaska ściana na stole
            najl, best = -1.0, None
            for r in rotacje:
                s = przesun(ksz, V(0, 0, 0), r)
                zmin = s.BoundBox.ZMin
                pole = 0.0
                for f in s.Faces:
                    try:
                        if f.Surface.TypeId == "Part::GeomPlane":
                            n = f.normalAt(0, 0)
                            if n.z < -0.999 and abs(f.BoundBox.ZMax - zmin) < 1e-3:
                                pole += f.Area
                    except Exception:
                        pass
                if pole > najl:
                    najl, best = pole, s
            bb = best.BoundBox
            best = przesun(best, V(-bb.Center.x, -bb.Center.y, -bb.ZMin))
            sciezka = os.path.join(katalog, plik)
            if MeshPart is not None:
                m = MeshPart.meshFromShape(Shape=best, LinearDeflection=0.02, AngularDeflection=0.087, Relative=False)
                m.write(sciezka)
            else:
                best.exportStl(sciezka)
            zapisane.append(plik)
        return zapisane


def zbuduj_ramie(doc, baza=None, poza=None, prefiks="R_", grupa_nadrz=None):
    r = Ramie(doc, baza, prefiks, grupa_nadrz)
    r.poza(poza or POZA_STARTOWA)
    return r


# =============================================================================
#  URUCHOMIENIE SAMODZIELNE
# =============================================================================
if not globals().get("RAMIE_JAKO_MODUL", False):
    NAZWA_DOK = "Ramie_robotyczne"
    if NAZWA_DOK in App.listDocuments():
        App.closeDocument(NAZWA_DOK)
    dok = App.newDocument(NAZWA_DOK)
    pokl = dok.addObject("Part::Feature", "Poklad_demo")
    pokl.Shape = kostka(-300, 300, -300, 300, -GRUBOSC_POKLADU, 0).cut(walecZ(25, -20, 5)).cut(
        kostka(-134, -74, -30, 30, -20, 5))
    if App.GuiUp:
        pokl.ViewObject.ShapeColor = (0.5, 0.5, 0.52)
        pokl.ViewObject.Transparency = 40
    RAMIE = zbuduj_ramie(dok)
    dok.recompute()

    if EKSPORT_STL:
        try:
            _kat = os.path.dirname(os.path.abspath(__file__))
        except NameError:
            _kat = os.path.join(os.path.expanduser("~"), "CAD")
        _stl = os.path.join(_kat, "STL_ramie")
        _pliki = RAMIE.eksportuj_stl(_stl)
        App.Console.PrintMessage("Zapisano %d plikow STL w %s\n" % (len(_pliki), _stl))

    if App.GuiUp:
        import FreeCADGui as Gui
        Gui.activeDocument().activeView().viewIsometric()
        Gui.SendMsgToActiveView("ViewFit")
        if ANIMACJA:
            RAMIE.animuj()
            App.Console.PrintMessage("Animacja: zatrzymaj wpisujac RAMIE.zatrzymaj()\n")
    App.Console.PrintMessage("Ramie gotowe. Sterowanie: RAMIE.ustaw(obrot, bark, lokiec, nadgarstek, obrot_chw, rozwarcie)"
                             " lub RAMIE.poza('probka')\n")
